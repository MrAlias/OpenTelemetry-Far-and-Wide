{
  "name": "opentelemetry-far-and-wide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KubeCon NA 2026 Observability Day talk materials for OpenTelemetry Far and Wide",
  "scripts": {
    "dev": "slidev slides.md",
    "build": "slidev build slides.md",
    "export": "slidev export slides.md --output .artifacts/slides/opentelemetry-far-and-wide.pdf",
    "storyboard:serve": "python3 -m http.server 8010 --bind 0.0.0.0 --directory public",
    "animation:serve": "python3 -m http.server 8010 --bind 0.0.0.0 --directory public",
    "present": "slidev slides.md --open",
    "slides:verify": "node scripts/presentation/verify_slides.mjs",
    "slides:assets": "python3 scripts/presentation/sync_assets.py"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@slidev/cli": "52.19.1",
    "@slidev/theme-default": "0.25.0"
  },
  "overrides": {
    "dompurify": "3.4.14"
  }
}
